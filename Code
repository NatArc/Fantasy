/* HELPER FUNCTIONS */


/* ===== NORMAL RESTART ===== */

void restartGame() {

    printf("\n\nPRESS ENTER TO RETURN TO THE BEGINNING...");
    getchar();
    getchar();

    /*
       Returning from the ending eventually brings
       the program back to main(), where the player
       is asked whether they want to play again.
    */
}


/* PAUSE */

void pauseGame() {

    printf("\n\nPRESS ENTER TO CONTINUE...");
    getchar();
    getchar();
}


/* CLEAR SCREEN */

void clearScreen() {

#ifdef _WIN32
    system("cls");
#else
    system("clear");
#endif

    /* Reset terminal to normal */
    printf("\033[0m");
}


/* RED SCREEN */
void redScreen() {

#ifdef _WIN32
    system("cls");
#else
    system("clear");
#endif

    printf("\033[48;2;80;0;0m");
    printf("\033[97m");
}


/* NORMAL SCREEN */


void normalScreen() {

#ifdef _WIN32
    system("cls");
#else
    system("clear");
#endif

    printf("\033[0m");
}
