/* ===== MAIN ===== */

int main() {

    int playAgain = 1;
    char answer;

    while (playAgain) {

        introduction();
        choice1();

        printf("\n\nPlay again? (Y/N): ");
        scanf(" %c", &answer);

        if (answer == 'Y' || answer == 'y') {
            clearScreen();
        }
        else {
            playAgain = 0;
        }
    }

    printf("\nThank you for playing Fantasy Quest Adventure!\n");

    return 0;
}


