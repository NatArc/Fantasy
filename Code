    if (betrayalUnlocked == 0) {

        betrayalUnlocked = 1;

        printf("============================================\n");
        printf("          SECRET PATH UNLOCKED              \n");
        printf("============================================\n\n");

        printf("SOMETHING FEELS DIFFERENT THIS TIME...\n\n");
        printf("...\n");

        pauseGame();

        /* This is a REAL restart.
           The game returns to the beginning. */

        return;
    }
    else {

        printf("RESTART AGAIN...\n");

        pauseGame();

        /* This is NOT a real restart.
           The player gets the secret choice. */

        choice4B();
    }
}


